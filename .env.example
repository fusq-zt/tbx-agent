# Copy to .env and review every external path. Never commit .env.
# Relative source/config/knowledge paths are resolved from the repository root.
TBX_AGENT_PROJECT_ROOT=.
TBX_AGENT_CONFIG_DIR=./configs
TBX_AGENT_KNOWLEDGE_DIR=./knowledge

# ---------------------------------------------------------------------------
# Portable release-facing settings
# ---------------------------------------------------------------------------
# Keep secrets as placeholders in this template. The application runtime
# mappings are listed in the LLM section below.
LLM_PROVIDER=llama_cpp
LLM_MODEL=tbx-medgemma-1.5-4b-it-q4-k-m
LLM_BASE_URL=http://127.0.0.1:11435/v1
LLM_API_KEY=<set-only-in-local-env>

# Retrieval mode, vector path, collection, weights and model provenance live in
# one strict YAML contract. Point this variable at an external copy when enabling
# Dense/Hybrid; environment variables do not silently override those fields.
TBX_AGENT_RETRIEVAL_CONFIG=./configs/retrieval.yaml

# The BGE adapter is offline-only. Point these to a pre-downloaded, hash-pinned
# snapshot and external cache after enabling it in the selected YAML contract.
RAG_EMBEDDING_MODEL_PATH=<external-bge-m3-snapshot>
RAG_EMBEDDING_CACHE_DIR=<external-bge-cache-dir>
RAG_EMBEDDING_DEVICE=auto

# Put raw, legally obtained guideline documents, mutable case state, and model
# weights outside the Git checkout for a real deployment.
GUIDELINE_SOURCE_DIR=<external-guideline-source-dir>
CASE_DATA_DIR=<external-case-data-dir>
MODEL_WEIGHT_DIR=<external-model-weight-dir>

# REQUIRED FOR A RELEASE DEPLOYMENT: keep state and uploads outside the checkout.
# TBX_RUNTIME_ROOT defaults to the same location and is used by the local
# llama.cpp setup helper.
# TBX_AGENT_DATA_ROOT=<external-runtime-root>
# TBX_RUNTIME_ROOT=<external-runtime-root>
# TBX_AGENT_DB_PATH=<external-runtime-root>/tbx_agent.sqlite3
# TBX_AGENT_CASE_ARTIFACT_ROOT=<external-runtime-root>/cases

# Bounded one-action controller. Observation is checked after every step.
TBX_AGENT_MAX_AGENT_STEPS=5
TBX_AGENT_MAX_TOOL_CALLS=4
TBX_AGENT_MAX_EXPENSIVE_VISION_CALLS=3
TBX_AGENT_TOOL_COST_BUDGET=10

# API/UI bindings. Keep the research deployment loopback-only.
TBX_AGENT_BIND_HOST=127.0.0.1
TBX_AGENT_BIND_PORT=8000
TBX_AGENT_API_URL=http://127.0.0.1:8000
TBX_AGENT_UI_PORT=8501
TBX_AGENT_DEPLOYMENT_PROFILE=research

# Normal launch is fail-closed. `run_local.ps1 -Demo` / `run_local.sh --demo`
# overrides these values for an explicitly labelled mock control-flow demo.
TBX_AGENT_VISION_BACKEND=rank03
TBX_AGENT_NARRATOR_BACKEND=llama_cpp
TBX_AGENT_REQUIRE_REAL_INFERENCE=true
TBX_AGENT_REQUIRE_LLM_INFERENCE=true

# Optional visualization-only MedSAM refinement. Leave disabled unless the
# `medsam_refinement` artifact group and `[medsam]` extra were installed and
# verified. Change `none` to `medsam_hf` only after that bootstrap succeeds.
TBX_AGENT_CONTOUR_REFINEMENT_BACKEND=none
TBX_AGENT_CONTOUR_REFINEMENT_DEVICE=auto

# Download the separately published inference bundle and install it with
# scripts/install_vision_bundle.py. No training code or weights are in this repository.
# Prefer its generated, hash-bound contract over per-file path overrides.
# TBX_ARTIFACT_ROOT=<external-artifact-root>
# TBX_AGENT_RANK03_RUNTIME_CONFIG=<external-runtime-root>/config/rank03_runtime.json

# scripts/setup_medgemma.py verifies the exact Q4_K_M file and writes a
# secret-free pointer file outside Git. The launcher loads it and supervises
# loopback llama.cpp when needed.
# TBX_AGENT_LLM_ENV_FILE=<external-runtime-root>/config/llm.env
# TBX_AGENT_LLM_RUNTIME_CONFIG=<external-runtime-root>/config/llm_runtime.generated.yaml
LLAMA_CPP_BASE_URL=http://127.0.0.1:11435
LLAMA_CPP_MODEL_ALIAS=tbx-medgemma-1.5-4b-it-q4-k-m
LLAMA_CPP_SERVER_BUILD=b10517
LLAMA_CPP_TIMEOUT_SECONDS=120
LLAMA_CPP_MAX_RESPONSE_BYTES=65536
TBX_AGENT_LLAMA_CPP_ALLOW_REMOTE=false

# OpenAI-compatible alternative. Set LLM_PROVIDER=openai_compatible and map
# LLM_* to OPENAI_* in the local .env; never commit a real key.
TBX_AGENT_OPENAI_ENABLED=false
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=<set-only-in-local-env>

# Supply exactly one strong credential via a protected file (preferred) or the
# process environment. Do not put the credential itself in this file.
# LLAMA_CPP_API_KEY_FILE=<protected-key-file>
# LLAMA_CPP_API_KEY=

# Privacy/traffic settings may be tightened for a reviewed deployment.
TBX_AGENT_METRICS_ENABLED=false
TBX_AGENT_HSTS_ENABLED=false

# Docker Compose real-runtime profile. Keep these commented for native runs;
# Compose requires every value explicitly and rejects missing model mounts.
# TBX_MODEL_CACHE=<external-registered-artifact-root>
# TBX_DFINE_ROOT=<external-artifact-root>/sources/D-FINE
# TBX_RANK03_RUNTIME_CONFIG_HOST=<external-runtime-root>/config/rank03_runtime.json
# TBX_LLM_RUNTIME_CONFIG_HOST=<external-runtime-root>/config/llm_runtime.generated.yaml
# TBX_LLAMA_BUNDLE_DIR=<external-runtime-root>/llama.cpp/b10517/bin
# TBX_LLAMA_BUNDLE_MANIFEST_HOST=<external-runtime-root>/provenance/llama-b10517-bundle.json
# TBX_LLAMA_SERVER_BINARY_NAME=llama-server (or llama-server.exe for a Windows-hosted service)
# TBX_UI_INSTALL_EXTRAS=ui,dicom
# LLAMA_CPP_API_KEY_FILE_HOST=<protected-llama-key-file>
# LLAMA_CPP_MODEL_SHA256=b31becdf4f39561800505514cce67681604fe449d04dd35c8c92fd7848c6d7bd
# TBX_EXTERNAL_LLM_URL=https://host.docker.internal:11435
